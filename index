<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>💕</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:wght@300;400;600&display=swap" rel="stylesheet">
<style>
  :root {
    --blush: #f9c6d0;
    --rose: #e8829a;
    --deep: #c0446a;
    --petal: #fde8ed;
    --cream: #fff5f7;
    --text: #7a2040;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    min-height: 100vh;
    background: linear-gradient(135deg, #fde8ed 0%, #fcd3e0 40%, #f9b8ce 70%, #f4a0be 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cormorant Garamond', serif;
    overflow: hidden;
    position: relative;
  }

  /* Falling hearts canvas */
  #hearts-canvas {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  /* Glass card */
  .card {
    position: relative;
    z-index: 10;
    background: rgba(255, 245, 247, 0.55);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1.5px solid rgba(255, 182, 203, 0.6);
    border-radius: 32px;
    padding: 60px 70px;
    text-align: center;
    box-shadow:
      0 8px 40px rgba(192, 68, 106, 0.15),
      0 2px 8px rgba(232, 130, 154, 0.2),
      inset 0 1px 0 rgba(255,255,255,0.7);
    max-width: 480px;
    width: 90vw;
    animation: floatIn 1s cubic-bezier(.23,1,.32,1) both;
  }

  @keyframes floatIn {
    from { opacity: 0; transform: translateY(40px) scale(0.95); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .big-emoji {
    font-size: 3.5rem;
    display: block;
    margin-bottom: 20px;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.12); }
  }

  h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    color: var(--text);
    line-height: 1.3;
    margin-bottom: 10px;
    font-weight: 700;
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--rose);
    font-style: italic;
    font-weight: 300;
    margin-bottom: 44px;
    letter-spacing: 0.02em;
  }

  .buttons {
    display: flex;
    gap: 18px;
    justify-content: center;
  }

  .btn {
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem;
    font-weight: 700;
    padding: 16px 48px;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: transform 0.18s cubic-bezier(.23,1,.32,1), box-shadow 0.18s;
    letter-spacing: 0.05em;
    position: relative;
    overflow: hidden;
  }

  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgba(255,255,255,0.15);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .btn:hover::after { opacity: 1; }

  .btn:hover {
    transform: translateY(-3px) scale(1.04);
  }

  .btn:active {
    transform: translateY(0) scale(0.98);
  }

  .btn-yes {
    background: linear-gradient(135deg, #e8829a, #c0446a);
    color: #fff;
    box-shadow: 0 6px 24px rgba(192, 68, 106, 0.4), 0 2px 6px rgba(192,68,106,0.2);
  }

  .btn-yes:hover {
    box-shadow: 0 12px 32px rgba(192, 68, 106, 0.5), 0 4px 10px rgba(192,68,106,0.3);
  }

  .btn-no {
    background: rgba(255, 245, 247, 0.8);
    color: var(--deep);
    border: 2px solid rgba(192, 68, 106, 0.35);
    box-shadow: 0 4px 16px rgba(192, 68, 106, 0.1);
  }

  .btn-no:hover {
    background: rgba(255, 230, 238, 0.9);
    box-shadow: 0 8px 24px rgba(192, 68, 106, 0.18);
  }

  /* Error toast */
  .toast {
    position: fixed;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%) translateY(80px);
    background: #fff0f3;
    border: 1.5px solid #e8829a;
    border-radius: 18px;
    padding: 14px 28px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.05rem;
    color: #c0446a;
    font-style: italic;
    box-shadow: 0 8px 30px rgba(192,68,106,0.2);
    z-index: 200;
    opacity: 0;
    transition: transform 0.4s cubic-bezier(.23,1,.32,1), opacity 0.4s;
    white-space: nowrap;
  }
  .toast.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }

  /* Phone number reveal */
  .phone-reveal {
    margin-top: 24px;
    background: rgba(255,245,247,0.9);
    border: 1.5px solid rgba(232,130,154,0.5);
    border-radius: 20px;
    padding: 18px 32px;
    display: inline-block;
    animation: popIn 0.5s cubic-bezier(.23,1,.32,1) both;
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.7); }
    to   { opacity: 1; transform: scale(1); }
  }

  .phone-label {
    font-size: 0.85rem;
    color: var(--rose);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .phone-number {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    color: var(--deep);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  /* Response message */
  .message {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 16px;
    animation: fadeIn 0.5s ease both;
  }

  .message.show { display: flex; }

  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.9); }
    to   { opacity: 1; transform: scale(1); }
  }

  .message-card {
    background: rgba(255, 245, 247, 0.85);
    backdrop-filter: blur(24px);
    border-radius: 32px;
    padding: 50px 60px;
    text-align: center;
    border: 1.5px solid rgba(255,182,203,0.6);
    box-shadow: 0 12px 50px rgba(192, 68, 106, 0.2);
  }

  .message-card h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2.2rem;
    color: var(--text);
    margin-bottom: 10px;
  }

  .message-card p {
    font-size: 1.15rem;
    color: var(--rose);
    font-style: italic;
  }

  /* Decorative dots */
  .dots {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .dot {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 182, 203, 0.25);
  }
</style>
</head>
<body>

<canvas id="hearts-canvas"></canvas>

<div class="dots" id="dots"></div>

<div class="card" id="mainCard">
  <span class="big-emoji">💝</span>
  <h1>Ты мне нравишься</h1>
  <p class="subtitle">Скажи мне честно...</p>
  <div class="buttons">
    <button class="btn btn-yes" onclick="answer('yes')">Да 💕</button>
    <button class="btn btn-no" onclick="answer('no')">Нет</button>
  </div>
</div>

<div class="message" id="yesMsg">
  <div class="message-card">
    <div style="font-size:3.5rem; margin-bottom:16px;">🥰💗</div>
    <h2>Я так и знал!</h2>
    <p>Это лучший день в моей жизни...</p>
    <div class="phone-reveal">
      <div class="phone-label">📱 Мой номер</div>
      <div class="phone-number">+7 (999) 123-45-67</div>
    </div>
  </div>
</div>

<div class="toast" id="errorToast">⚠️ Ошибка: этот вариант недоступен 💕</div>

<script>
  // === Falling Hearts ===
  const canvas = document.getElementById('hearts-canvas');
  const ctx = canvas.getContext('2d');

  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;

  window.addEventListener('resize', () => {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  });

  const EMOJIS = ['💕','💗','💓','💖','💘','❤️','🩷','💝','💞'];

  class Heart {
    constructor() { this.reset(true); }

    reset(initial = false) {
      this.x = Math.random() * canvas.width;
      this.y = initial ? Math.random() * canvas.height : -60;
      this.size = 18 + Math.random() * 28;
      this.speed = 0.6 + Math.random() * 1.4;
      this.drift = (Math.random() - 0.5) * 0.8;
      this.rotation = (Math.random() - 0.5) * 0.3;
      this.rotSpeed = (Math.random() - 0.5) * 0.02;
      this.opacity = 0.4 + Math.random() * 0.55;
      this.emoji = EMOJIS[Math.floor(Math.random() * EMOJIS.length)];
      this.wobble = Math.random() * Math.PI * 2;
      this.wobbleSpeed = 0.02 + Math.random() * 0.02;
    }

    update() {
      this.y += this.speed;
      this.wobble += this.wobbleSpeed;
      this.x += this.drift + Math.sin(this.wobble) * 0.5;
      this.rotation += this.rotSpeed;
      if (this.y > canvas.height + 80) this.reset();
    }

    draw() {
      ctx.save();
      ctx.globalAlpha = this.opacity;
      ctx.font = `${this.size}px serif`;
      ctx.translate(this.x, this.y);
      ctx.rotate(this.rotation);
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(this.emoji, 0, 0);
      ctx.restore();
    }
  }

  const hearts = Array.from({ length: 38 }, () => new Heart());

  function animate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    hearts.forEach(h => { h.update(); h.draw(); });
    requestAnimationFrame(animate);
  }
  animate();

  // === Decorative blobs ===
  const dotsEl = document.getElementById('dots');
  for (let i = 0; i < 6; i++) {
    const d = document.createElement('div');
    d.className = 'dot';
    const s = 80 + Math.random() * 200;
    d.style.cssText = `
      width:${s}px; height:${s}px;
      top:${Math.random()*100}%; left:${Math.random()*100}%;
      transform: translate(-50%,-50%);
    `;
    dotsEl.appendChild(d);
  }

  // === Button logic ===
  const noBtn = document.querySelector('.btn-no');
  let noAttempts = 0;

  const errorMessages = [
    '⚠️ Ошибка: этот вариант недоступен 💕',
    '🚫 Система не принимает этот ответ',
    '❌ Неверный выбор, попробуй снова~',
    '💔 404: Ответ "Нет" не найден',
    '🛑 Упс! Что-то пошло не так...',
  ];

  noBtn.addEventListener('mouseover', () => {
    const card = document.getElementById('mainCard');
    const rect = card.getBoundingClientRect();
    const maxX = window.innerWidth - rect.width - 20;
    const maxY = window.innerHeight - rect.height - 20;
    const newX = Math.max(20, Math.random() * maxX);
    const newY = Math.max(20, Math.random() * maxY);
    card.style.position = 'fixed';
    card.style.left = newX + 'px';
    card.style.top = newY + 'px';
    card.style.transform = 'none';
    card.style.transition = 'left 0.3s cubic-bezier(.23,1,.32,1), top 0.3s cubic-bezier(.23,1,.32,1)';
    card.style.margin = '0';
  });

  noBtn.addEventListener('click', () => {
    const toast = document.getElementById('errorToast');
    toast.textContent = errorMessages[noAttempts % errorMessages.length];
    noAttempts++;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2200);
  });

  function answer(choice) {
    if (choice === 'yes') {
      document.getElementById('mainCard').style.display = 'none';
      document.getElementById('yesMsg').classList.add('show');
      burst();
    }
  }

  function burst() {
    for (let i = 0; i < 20; i++) {
      const h = new Heart();
      h.y = canvas.height / 2 + (Math.random() - 0.5) * 100;
      h.x = canvas.width / 2 + (Math.random() - 0.5) * 100;
      h.speed = 1.5 + Math.random() * 3;
      h.size = 28 + Math.random() * 24;
      hearts.push(h);
    }
  }
</script>
</body>
</html>
